{
  "name": "seokdok-web",
  "version": "0.1.0",
  "private": true,
  "description": "seokdok.mkpo.li: try the 釋讀 input method in the browser",
  "license": "MIT",
  "author": "mkpoli",
  "type": "module",
  "scripts": {
    "wasm": "cd ../crates/seokdok-wasm && wasm-pack build --release --target web --out-dir ../../web/pkg --out-name seokdok",
    "dict": "bun scripts/bundle-dict.mjs",
    "dev": "vite",
    "build": "bun run wasm && bun run dict && vite build",
    "preview": "vite preview",
    "test": "bun test src",
    "deploy": "bun run build && bunx wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "svelte": "5.57.0",
    "vite": "7.3.6",
    "wrangler": "4.156.0"
  }
}
